{
  "name": "blog",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "workspaces": [
    "src/client",
    "src/server"
  ],
  "scripts": {
    "dev:frontend": "pnpm --filter blog-client run dev",
    "dev:backend": "pnpm --filter blog-server run dev",
    "dev": "concurrently \"pnpm run dev:frontend\" \"pnpm run dev:backend\"",
    "build": "pnpm run -r build",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "typescript-eslint": "^8.21.0"
  }
}
